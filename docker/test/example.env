# Existing host directory / mounted DFS; the same namespace on every node.
LOCAL_TARGETS_DIR=/absolute/path/to/targets
BOOTSTRAP_SERVERS=kafka.example:9092
TOPIC=gflow.events
API_PORT=8000
WORKERS=2
DISPATCH_TIMEOUT=10
DISPATCH_RECHECK=600
MAX_UPLOADS=4
MAX_UPLOAD_BYTES=107374182400
KAFKA_TIMEOUT=20
KAFKA_RETRY_DELAY=5
KAFKA_LOG_INTERVAL=30
HEARTBEAT_INTERVAL=10
HEARTBEAT_TIMEOUT=600
# Container shutdown grace only; not a task execution timeout.
WORKER_STOP_GRACE=3600s
